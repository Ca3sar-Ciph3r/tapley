# Tapley Connect — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: Service role key bypasses RLS. NEVER expose to the browser.
# Only used server-side in: /api/view-event, /c/[slug], super admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tapleys.co.za

# ── Make.com Webhooks ─────────────────────────────────────────────────────────
# Fired server-side from API routes. Never exposed to browser.
MAKE_WEBHOOK_VIEW_EVENT=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_CONTACT_CAPTURED=https://hook.eu1.make.com/your-webhook-id

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Found in: resend.com → API Keys
# Used for onboarding drip emails and monthly digests. Never expose to browser.
RESEND_API_KEY=re_your_api_key_here

# ── Notifications ─────────────────────────────────────────────────────────────
# Email address to notify when a referral is created via createCompany.
# Set this to your own email (e.g. lukegunn90@gmail.com).
SUPER_ADMIN_NOTIFY_EMAIL=lukegunn90@gmail.com

# ── PayFast ───────────────────────────────────────────────────────────────────
# Used for self-service onboarding setup fee payments (ZAR, South Africa).
# Found in: payfast.co.za → Account → Merchant Details
# NEVER expose PAYFAST_MERCHANT_KEY or PAYFAST_PASSPHRASE to the browser.
#
# Set PAYFAST_SANDBOX=true for sandbox (testing) — remove or set false for production.
# ITN notify_url (onboarding):    https://tapleys.co.za/api/billing/payfast-itn
# ITN notify_url (add-cards):     https://tapleys.co.za/api/webhooks/payfast
# Note: ITN requires a publicly accessible URL — use ngrok for local dev testing.
PAYFAST_MERCHANT_ID=your_merchant_id_here
PAYFAST_MERCHANT_KEY=your_merchant_key_here
PAYFAST_PASSPHRASE=your_passphrase_here
PAYFAST_SANDBOX=true

# ── Self-service onboarding notifications ─────────────────────────────────────
# Email address that receives a notification when a self-service company signs up.
# Separate from SUPER_ADMIN_NOTIFY_EMAIL (which is for referrals).
ADMIN_NOTIFICATION_EMAIL=lukegunn90@gmail.com

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Random secret used to authenticate Vercel Cron requests.
# Generate with: openssl rand -base64 32
# Set this same value in Vercel dashboard → Project Settings → Environment Variables.
# Vercel Cron automatically passes it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_random_secret_here

# ── Google Wallet ──────────────────────────────────────────────────────────────
# Enables "Add to Google Wallet" buttons on public card pages.
# Set NEXT_PUBLIC_GOOGLE_WALLET_ENABLED=true to show the wallet buttons.
#
# Step-by-step setup:
#   1. Open Google Pay & Wallet Console: https://pay.google.com/business/console
#   2. Create an Issuer account → copy the Issuer ID (numeric)
#   3. Create a Google Cloud service account with "Google Wallet API" scope
#   4. Download the JSON key file for the service account
#   5. Base64-encode the private_key field (no newlines):
#        node -e "const k=require('./key.json'); process.stdout.write(Buffer.from(k.private_key).toString('base64'))"
#   6. Fill in the three values below
#
# NEVER expose GOOGLE_SERVICE_ACCOUNT_EMAIL or GOOGLE_SERVICE_ACCOUNT_KEY to the browser.
NEXT_PUBLIC_GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=your_issuer_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_rsa_private_key_no_newlines
